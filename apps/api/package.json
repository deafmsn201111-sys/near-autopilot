{
  "name": "@near-autopilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/analytics/main.ts",
    "start": "tsx src/analytics/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run test/drizzle-repository.integration.test.ts test/orchestrator-stores.integration.test.ts test/checkpoint.integration.test.ts test/llm-ledger.integration.test.ts test/deposit-store.integration.test.ts",
    "test:live:yield": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run test/yield.live.test.ts",
    "collector:backfill": "node --import tsx src/collector/backfill-main.ts",
    "audit:verify": "node --import tsx src/evidence/cli.ts verify",
    "audit:replay": "node --import tsx src/evidence/cli.ts replay",
    "demo:attack": "node --import tsx src/demo/attack-main.ts",
    "thesis:fetch": "node --import tsx src/thesis/fetch.ts",
    "thesis:rebuild": "node --import tsx src/thesis/rebuild.ts",
    "llm:compare": "node --env-file-if-exists=../../.env --import tsx src/llm/compare-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@near-autopilot/agents": "workspace:*",
    "@near-autopilot/burrow-adapter": "workspace:*",
    "@near-autopilot/config": "workspace:*",
    "@near-autopilot/core": "workspace:*",
    "@near-autopilot/db": "workspace:*",
    "@near-autopilot/financial-engine": "workspace:*",
    "@near-autopilot/near-adapter": "workspace:*",
    "@near-autopilot/orchestrator": "workspace:*",
    "@near-autopilot/policy-engine": "workspace:*",
    "@near-autopilot/rhea-adapter": "workspace:*",
    "@near-autopilot/rhea-dcl-adapter": "workspace:*",
    "@near-autopilot/tx-execution": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@near-js/crypto": "2.5.1",
    "@near-js/utils": "2.5.1",
    "borsh": "1.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
