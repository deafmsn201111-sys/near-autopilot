{
  "name": "@near-autopilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run test/drizzle-repository.integration.test.ts",
    "testnet-tx": "tsx --env-file-if-exists=../../.env src/testnet-tx/cli.ts",
    "test:live:yield": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run test/yield.live.test.ts",
    "collector:backfill": "node --import tsx src/collector/backfill-main.ts"
  },
  "dependencies": {
    "@near-autopilot/agents": "workspace:*",
    "@near-autopilot/burrow-adapter": "workspace:*",
    "@near-autopilot/config": "workspace:*",
    "@near-autopilot/core": "workspace:*",
    "@near-autopilot/db": "workspace:*",
    "@near-autopilot/financial-engine": "workspace:*",
    "@near-autopilot/near-adapter": "workspace:*",
    "@near-autopilot/orchestrator": "workspace:*",
    "@near-autopilot/policy-engine": "workspace:*",
    "@near-autopilot/rhea-adapter": "workspace:*",
    "@near-autopilot/rhea-dcl-adapter": "workspace:*",
    "@near-autopilot/tx-execution": "workspace:*",
    "fastify": "^5.2.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
