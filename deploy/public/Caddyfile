{$SITE_ADDRESS} {
	encode gzip

	# The admin is served only by the loopback analytics-admin service; the public site never shows it.
	respond /admin 404
	respond /admin/* 404

	# Only the dashboard is exposed. The visitor's address is set by Caddy, never taken from the request:
	# the rate limits key on it (apps/analytics/lib/rate-limit.ts).
	reverse_proxy analytics:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		# The live AI pipeline is Server-Sent Events: pass each event on as it comes (D24).
		flush_interval -1
	}

	# A baseline policy added next to the app's nonce policy (apps/analytics/lib/csp.ts); browsers enforce both, so
	# these hold even if the app's header is lost. `+` adds a header line, it never replaces the app's.
	header {
		defer
		+Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
