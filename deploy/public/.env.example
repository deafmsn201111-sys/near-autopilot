# Public demo server settings. setup.sh creates .env from this file and fills the generated secrets.
# Never commit or share .env.

# Caddy (ports 80 and 443 on this server): COMPOSE_PROFILES=caddy and the address it serves. Without a domain of your
# own, use <server IP>.sslip.io: it resolves to that IP and Caddy gets a real HTTPS certificate for it. `setup.sh <IP>`
# fills both. Leave both empty behind a NAT and use Tailscale Funnel instead (README).
COMPOSE_PROFILES=
SITE_ADDRESS=

# Generated by setup.sh (random). Internal only: never shown on the site.
POSTGRES_PASSWORD=
API_TOKEN=
# The admin's own token (/v1/admin/*): only analytics-api and the loopback analytics-admin get it.
ADMIN_API_TOKEN=

# Read-only mainnet RPC. With a FastNEAR key the collector cycles are complete; without one, set
# MAINNET_READ_RPC_URL=https://rpc.mainnet.near.org (slower, rate limited). The key is sent as a Bearer header.
MAINNET_READ_RPC_URL=https://rpc.mainnet.fastnear.com
MAINNET_READ_RPC_API_KEY=

# Optional. Without it Pyth is reported unavailable and the other price sources are used.
PYTH_API_KEY=

# 1Click partner JWT (partners.near-intents.org) for deposits from other chains. Empty = 1Click adds 0.25%
# per deposit instead of 0.20% (0.01% for stablecoin or same-asset pairs). Sent only to 1Click; never logged.
ONE_CLICK_JWT=

# Server LLM (Anthropic, pay-as-you-go key with a spend limit). Empty = LLM off, heuristics only. Never logged.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 or claude-sonnet-5-5; anything else stops the API at start.
ANTHROPIC_MODEL=claude-haiku-5-5
# Hard cap on one reply.
ANTHROPIC_MAX_TOKENS=4096
# AI spend per UTC day in USD; once reached, everyone gets the labelled rule-based list.
LLM_DAILY_CAP_USD=5

# How often the collector reads mainnet, in seconds (15 minutes).
SHADOW_CYCLE_INTERVAL_SECONDS=900

# Signed audit checkpoints: a NEW key pair for this server, appended by setup.sh.
