{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@near-autopilot/api#test": {
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/config/**",
        "$TURBO_ROOT$/THESIS.md",
        "$TURBO_ROOT$/docs/evidence/**",
        "$TURBO_ROOT$/thesis/**"
      ]
    }
  },
  "globalDependencies": [
    "eslint.config.mjs",
    "boundaries.config.mjs",
    "tsconfig.base.json",
    ".prettierrc.json"
  ]
}
