# ---- API ----
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Shared secret between the site and the API. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters
# Must match POSTGRES_* below (host side: 127.0.0.1 and POSTGRES_HOST_PORT).
DATABASE_URL=postgres://autopilot:replace-with-the-postgres-password@localhost:5432/autopilot

# Mainnet. The API checks at start-up that NEAR_RPC_URL really serves this network.
NEAR_NETWORK=mainnet
# The public endpoint is rate limited (HTTP 429 under load); use a dedicated RPC provider for anything real.
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Optional key for a hosted RPC provider, sent as Authorization: Bearer. Never logged.
NEAR_RPC_API_KEY=
# The collector's agents analyse the simulated demo portfolios as this (non-existent) account. Never signs.
AUTOPILOT_ACCOUNT_ID=shadow-demo.near
# The server never signs: dry-run is the only execution mode (live is rejected at start-up).
EXECUTION_MODE=dry-run
# Token/pool allowlists and market limits for the collector and its agents.
MARKET_CONFIG_FILE=./config/market.json
AUTOPILOT_ENGINE=orchestrator
DATA_SOURCE=simulation

# Server LLM (Anthropic, pay-as-you-go key with a spend limit). Empty = LLM off, heuristics only. Never logged.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Hard cap on one reply.
ANTHROPIC_MAX_TOKENS=4096

# Mainnet has built-in defaults (v2.ref-finance.near, contract.main.burrow.near, priceoracle.near).
# Set these only to override the contract ids.
#RHEA_CONTRACT_ID=v2.ref-finance.near
#BURROW_CONTRACT_ID=contract.main.burrow.near
#BURROW_ORACLE_ID=priceoracle.near

# ---- Site (apps/analytics) ----
API_BASE_URL=http://localhost:4003
# 1 = the site may hand a validated, unsigned cascade to the connected wallet; the user signs it there.
MAINNET_WALLET_SIGNING=

# ---- Docker Compose ----
# Host ports (always bound to 127.0.0.1). Change if something else already listens there.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=autopilot
# Generate with: openssl rand -hex 24 (hex keeps DATABASE_URL free of characters that need URL-encoding)
POSTGRES_PASSWORD=replace-with-the-postgres-password
POSTGRES_DB=autopilot

# Collector schedule (seconds) and full Rhea registry rescan every N cycles.
SHADOW_CYCLE_INTERVAL_SECONDS=900
COLLECTOR_REGISTRY_EVERY=4
# The site (127.0.0.1:3001) and its read-only API.
ANALYTICS_DASHBOARD_PORT=3001
ANALYTICS_API_HOST_PORT=4003
MAINNET_READ_RPC_URL=https://rpc.mainnet.fastnear.com
MAINNET_READ_RPC_API_KEY=
# Pyth Hermes requires an API key (https://docs.pyth.network). Leave empty to use DefiLlama only. Never commit a key.
PYTH_API_KEY=
