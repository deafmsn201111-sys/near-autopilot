# ---- API ----
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Shared secret between dashboard and API. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters
# Must match POSTGRES_* below (host side: 127.0.0.1 and POSTGRES_HOST_PORT).
DATABASE_URL=postgres://autopilot:replace-with-the-postgres-password@localhost:5432/autopilot

# Testnet by default. The API checks at start-up that NEAR_RPC_URL really serves this network.
NEAR_NETWORK=testnet
# The public endpoint is rate limited (HTTP 429 under load); use a dedicated RPC provider for anything real.
NEAR_RPC_URL=https://rpc.testnet.near.org
AUTOPILOT_ACCOUNT_ID=your-account.testnet

# dry-run: plan + policy-check + record, never sign or send. live: requires a signer (docs/security.md)
# and is REJECTED when NEAR_NETWORK=mainnet: this system never signs with mainnet keys.
EXECUTION_MODE=dry-run
# 0 = scheduler off (trigger cycles with POST /v1/runs)
CYCLE_INTERVAL_SECONDS=0
AUTOPILOT_CONFIG_FILE=./config/autopilot.json
# legacy: packages/agents guardian (+ optional rebalancer). orchestrator: multi-agent decision engine (dry-run only).
AUTOPILOT_ENGINE=legacy
# chain: read NEAR_NETWORK through NEAR_RPC_URL. simulation: synthetic demo portfolio via an in-process mock RPC
# (no network access at all, dry-run only, every row labelled "simulation"). Portfolios: demo-500 | demo-5000.
DATA_SOURCE=chain
SIMULATION_PORTFOLIO=demo-500

# REQUIRED when NEAR_NETWORK=testnet (mainnet has built-in defaults: v2.ref-finance.near,
# contract.main.burrow.near, priceoracle.near).
# Testnet values below were confirmed with read-only view calls on 2026-11-04 (see docs/security.md):
#   ref-finance-101.testnet            - deployed code; get_pool / get_return answer (2894 pools)
#   contract.1638481328.burrow.testnet - passes BurrowVerifier (chain id, exports, oracle identity)
#   priceoracle.testnet                - the oracle Burrow's get_config names; NOTE: it reported NO fresh
#                                        prices for any listed asset, so no testnet decision can be priced.
RHEA_CONTRACT_ID=ref-finance-101.testnet
BURROW_CONTRACT_ID=contract.1638481328.burrow.testnet
BURROW_ORACLE_ID=priceoracle.testnet

# ---- Dashboard ----
API_BASE_URL=http://localhost:4000

# ---- Docker Compose ----
# Host ports (always bound to 127.0.0.1). Change if something else already listens there.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=4000
DASHBOARD_PORT=3000
POSTGRES_USER=autopilot
# Generate with: openssl rand -hex 24 (hex keeps DATABASE_URL free of characters that need URL-encoding)
POSTGRES_PASSWORD=replace-with-the-postgres-password
POSTGRES_DB=autopilot

# ---- Read-only testnet profile (docker compose --profile testnet up -d) ----
# An EXISTING testnet account; it is only read (view calls), never signed for. Config file:
# cp config/autopilot.testnet.example.json config/autopilot.testnet.local.json and set policy.signerAccountId to it.
TESTNET_ACCOUNT_ID=your-account.testnet
# The public endpoint rate-limits (HTTP 429); a dedicated provider URL can go here (keep any key in .env only).
TESTNET_RPC_URL=https://rpc.testnet.near.org
TESTNET_ENGINE=orchestrator
TESTNET_API_HOST_PORT=4001
TESTNET_DASHBOARD_PORT=3002
