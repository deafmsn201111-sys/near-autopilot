# ---- API ----
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=4000
# Shared secret between dashboard and API. Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://autopilot:autopilot@localhost:5432/autopilot

NEAR_NETWORK=mainnet
# The public endpoint is rate limited; use a dedicated RPC provider for anything real.
NEAR_RPC_URL=https://rpc.mainnet.near.org
AUTOPILOT_ACCOUNT_ID=your-account.near

# dry-run: plan + policy-check + record, never sign or send. live: requires a signer (docs/security.md)
# and is REJECTED when NEAR_NETWORK=mainnet: this system never signs with mainnet keys.
EXECUTION_MODE=dry-run
# 0 = scheduler off (trigger cycles with POST /v1/runs)
CYCLE_INTERVAL_SECONDS=0
AUTOPILOT_CONFIG_FILE=./config/autopilot.json

# Mainnet defaults are built in. REQUIRED when NEAR_NETWORK=testnet.
# RHEA_CONTRACT_ID=v2.ref-finance.near
# BURROW_CONTRACT_ID=contract.main.burrow.near
# BURROW_ORACLE_ID=priceoracle.near

# ---- Dashboard ----
API_BASE_URL=http://localhost:4000

# ---- Docker Compose (postgres) ----
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=autopilot
